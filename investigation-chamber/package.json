{
  "name": "investigation-chamber",
  "version": "1.0.0",
  "description": "نظام إدارة غرفة التحقيق - القطب الجزائي الوطني لمكافحة الإرهاب و الجريمة المنظمة عبر الوطنية",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "author": "National Specialized Criminal Pole",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --outDir dist-electron --watch\" \"wait-on tcp:5173 dist-electron/electron/main.js && electron .\"",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json --outDir dist-electron && node scripts/copy-electron-assets.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist:win": "npm run build && npm run rebuild:native:win && electron-builder --win --x64 && npm run rebuild:native:host",
    "rebuild:native:win": "electron-rebuild -f -w better-sqlite3-multiple-ciphers -a x64 --platform win32",
    "rebuild:native:host": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "seed": "npm run build:electron && electron dist-electron/electron/seedRunner.js"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "11.6.0",
    "d3-force": "^3.0.0",
    "docx": "^9.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tanstack/react-virtual": "^3.10.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
