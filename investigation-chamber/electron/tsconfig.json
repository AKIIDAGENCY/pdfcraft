{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"]
    },
    "rootDir": "..",
    "outDir": "../dist-electron"
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "../shared/**/*.test.ts"]
}
