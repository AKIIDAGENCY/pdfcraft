<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InvestigationRoom.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B71C1C"/>
        </Style>

        <Style Selector="Button.danger-flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="Button.danger-flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26D32F2F"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D47A1"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>

</Application>
